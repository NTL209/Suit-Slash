<Window x:Class="Suit___Slash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suit &amp; Slash - Trận Đấu" Height="740" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#162820">

    <Window.Resources>
        <!-- Style cho nút chức năng bo tròn -->
        <Style x:Key="GameButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" Opacity="0.4" BlurRadius="6"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho lá bài trên tay (Click để nhô lên và phát sáng) -->
        <Style x:Key="PlayingCardStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="102"/>
            <Setter Property="Height" Value="145"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="cardBorder" Background="#FAFAFA" BorderBrush="#BDBDBD" 
                                BorderThickness="2" CornerRadius="10" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" Opacity="0.5" BlurRadius="8"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Góc trên trái -->
                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Rank}" FontSize="19" FontWeight="Bold" Foreground="{Binding Color}"/>
                                    <TextBlock Text="{Binding Suit}" FontSize="17" Foreground="{Binding Color}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Biểu tượng lớn ở giữa -->
                                <TextBlock Text="{Binding Suit}" FontSize="42" Foreground="{Binding Color}" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Góc dưới phải (xoay ngược) -->
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                                    <StackPanel.RenderTransform>
                                        <RotateTransform Angle="180"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="{Binding Rank}" FontSize="19" FontWeight="Bold" Foreground="{Binding Color}"/>
                                    <TextBlock Text="{Binding Suit}" FontSize="17" Foreground="{Binding Color}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Khi được bấm chọn -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#FFD54F"/>
                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="3.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-25"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- Khi di chuột vào -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Bố cục 3 tầng chính -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="4.0*"/>
            <!-- Tầng 1: Khu vực Boss -->
            <RowDefinition Height="4.5*"/>
            <!-- Tầng 2: Khu vực Bàn chơi & Bài trên tay -->
            <RowDefinition Height="1.5*"/>
            <!-- Tầng 3: Thanh máu người chơi & Nút chức năng -->
        </Grid.RowDefinitions>

        <!-- TẦNG 1: KHU VỰC BOSS -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="txtBossName" Text="BOSS: VUA BỊP" Foreground="#FFD54F"
                       FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Khung hình ảnh Boss -->
            <Border Width="160" Height="160" CornerRadius="15" Background="#243E33" 
                    BorderBrush="#E53935" BorderThickness="2" Margin="0,0,0,10">
                <Image x:Name="imgBoss" Stretch="Uniform"/>
            </Border>

            <!-- Thanh máu Boss -->
            <Grid Width="340" Height="26">
                <ProgressBar x:Name="pbBossHp" Minimum="0" Maximum="1000" Value="1000" 
             Foreground="#E53935" Background="#2C1A1A" BorderThickness="0"/>
                <TextBlock x:Name="txtBossHp" Text="HP: 1000 / 1000" Foreground="White" 
           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- TẦNG 2: KHU VỰC BÀN CHƠI (BÀI TRÊN TAY) -->
        <Grid Grid.Row="1">
            <Border Background="#1D352B" CornerRadius="16" BorderBrush="#2E5243" BorderThickness="1.5" Padding="15">
                <StackPanel VerticalAlignment="Center">
                    <!-- Dòng thông báo tay bài / sát thương dự kiến -->
                    <TextBlock x:Name="txtHandStatus" Text="Chọn bài trên tay rồi bấm 'Đánh bài' để tấn công Boss" 
                               Foreground="#A5D6A7" FontSize="14" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,0,0,22"/>

                    <!-- Danh sách lá bài tự động co giãn -->
                    <ItemsControl x:Name="icPlayerHand" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource PlayingCardStyle}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TẦNG 3: MÁU NGƯỜI CHƠI & NÚT CHỨC NĂNG (4 NÚT CĂN CHÍNH GIỮA) -->
        <Grid Grid.Row="2" VerticalAlignment="Bottom">
            <!-- Góc trái: Thanh máu Người chơi & Bộ bài 52 lá -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="txtDeckCount" Text="Bộ bài còn lại: 52 / 52 lá" Foreground="#B0BEC5" 
                           FontSize="13" Margin="0,0,0,6"/>
                <Grid Width="240" Height="26">
                    <ProgressBar x:Name="pbPlayerHp" Minimum="0" Maximum="100" Value="100" 
                                 Foreground="#43A047" Background="#1B2E1E" BorderThickness="0"/>
                    <TextBlock x:Name="txtPlayerHp" Text="HP Người chơi: 100 / 100" Foreground="White" 
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Chính giữa màn hình: 4 nút hành động chính -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnPlayCard" Content="Đánh bài" Background="#E53935" Padding="24,12" FontSize="16" Style="{StaticResource GameButtonStyle}"/>
                <Button x:Name="btnDrawCard" Content="Rút bài" Background="#1E88E5" Style="{StaticResource GameButtonStyle}"/>
                <Button x:Name="btnDiscard" Content="Bỏ bài" Background="#FB8C00" Style="{StaticResource GameButtonStyle}"/>
                <Button x:Name="btnEndTurn" Content="Kết thúc lượt" Background="#43A047" Style="{StaticResource GameButtonStyle}"/>
            </StackPanel>

            <!-- Góc phải: Nút Bỏ cuộc tách riêng -->
            <Button x:Name="btnSurrender" Content="Bỏ cuộc" Background="#616161" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GameButtonStyle}"/>
        </Grid>
    </Grid>
</Window>